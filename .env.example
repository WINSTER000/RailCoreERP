# ---------------------------------------------------------------------------
# RailCore ERP - local development environment
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Django ---------------------------------------------------------------------
SECRET_KEY=replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
RAILCORE_PAGE_SIZE=10

# Database -------------------------------------------------------------------
# DB_ENGINE accepts: mysql (default) | postgresql | sqlite
DB_ENGINE=mysql
DB_NAME=railcore
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Production (Render) --------------------------------------------------------
# When DATABASE_URL is present it overrides every DB_* variable above.
# DATABASE_URL=postgresql://user:password@host:5432/railcore_erp
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
